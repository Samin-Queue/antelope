#!/bin/sh
# 깨진 커밋이 main 에 올라가지 않게, 그리고 원격과 갈라진 채로 푸시하지 않게 막는다.
# GitHub Actions 는 푸시 이후에 돌아 게이트가 되지 못하고, 무료 플랜 프라이빗
# 레포는 branch protection 이 403 이라 required check 도 걸 수 없다.
#
# 급할 때는 `git push --no-verify` 로 건너뛸 수 있다.

set -e

REMOTE_BRANCH=main

# ── 1. 원격과 갈라졌는지 먼저 본다 ─────────────────────────────────────
# 여기서 막지 않으면 non-fast-forward 로 실패하고, 그때 force push 로
# 남의 커밋을 날리는 사고가 난다.
if git fetch origin "$REMOTE_BRANCH" --quiet 2>/dev/null; then
  BEHIND=$(git rev-list --count "HEAD..origin/$REMOTE_BRANCH" 2>/dev/null || echo 0)
  if [ "$BEHIND" -gt 0 ]; then
    echo "pre-push: 원격이 $BEHIND 커밋 앞서 있습니다. 먼저 리베이스하세요."
    echo ""
    echo "    git pull --rebase origin $REMOTE_BRANCH"
    echo ""
    echo "  (pull.rebase=true 라 'git pull' 만 해도 리베이스됩니다."
    echo "   작업 중인 변경은 rebase.autoStash 가 알아서 넣었다 뺍니다.)"
    exit 1
  fi
fi

# ── 2. 로컬 검증 ────────────────────────────────────────────────────
# 전체 빌드 대신 format/lint/typecheck 만 돌린다 — 10초대에 끝나고, 실제로
# main 을 깨뜨렸던 부류(삭제된 모듈 import)는 typecheck 가 잡는다.
echo "pre-push: format · lint · typecheck"
pnpm format:check
pnpm lint
pnpm typecheck
echo "pre-push: 통과"
