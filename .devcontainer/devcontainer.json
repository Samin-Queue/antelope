{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "antelope",

  // 팀·Railway 가 쓰는 compose 를 그대로 재사용하고, devcontainer 전용 설정만 얹는다.
  "dockerComposeFile": ["../compose.yaml", "compose.yaml"],
  "service": "app",
  "workspaceFolder": "/app",
  "runServices": ["app", "db"],
  "shutdownAction": "stopCompose",
  "remoteUser": "root",

  // features 는 이미지 빌드 시점에 구워진다 — 컨테이너를 다시 만들어도 재설치가 없다.
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  "forwardPorts": [3000, 5432],
  "portsAttributes": {
    "3000": { "label": "next dev" },
    "5432": { "label": "postgres" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // 기본값이면 postCreate 가 끝나기 전에 에디터가 붙어서, 터미널을 열었을 때
  // 아직 설치가 안 끝난 node_modules·CLI 를 물게 된다.
  "waitFor": "postCreateCommand"
}
