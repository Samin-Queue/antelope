# ── 데이터베이스 ────────────────────────────────────────────────────────
# 로컬: `pnpm docker:db` 로 띄운 뒤 아래 값 그대로 사용
# 프로덕션: Railway 가 ${{Postgres.DATABASE_URL}} 로 자동 주입
DATABASE_URL=postgres://postgres:postgres@localhost:5432/antelope

# ── LLM 프로바이더 스위치 ────────────────────────────────────────────────
# upstage | azure | backendai | openai | custom
LLM_PROVIDER=upstage
# 프리셋 기본값을 덮어쓸 때만 사용
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=

# Upstage — base https://api.upstage.ai/v1
#   chat:  solar-pro4(최신) / solar-pro3 / solar-pro2 / solar-mini
#   문서:  document-parse, ocr, information-extract (src/lib/upstage.ts)
UPSTAGE_API_KEY=
# Studio(/v2) 전용 키. 비우면 UPSTAGE_API_KEY 를 쓴다.
# ⚠ Agent·Config 는 키 소유 계정에 묶인다 — 키를 바꾸면 pnpm studio:provision 재실행
UPSTAGE_STUDIO_API_KEY=
# Studio 에이전트 ID (Parse → Classify → Extract → Instruct)
# 없으면 v1 REST 직접 호출로 떨어진다
UPSTAGE_AGENT_ID=
UPSTAGE_VALIDATION_AGENT_ID=
UPSTAGE_ANALYSIS_AGENT_ID=

# 공공데이터포털 오픈 API (data.go.kr)
#   JOB  : 중소벤처기업부 기업마당 지원사업
#   EXAM : 한국산업인력공단 국가자격 시험일정
# ⚠ 발급 키는 이미 URL 인코딩돼 있다. 쿼리에 그대로 붙인다 —
#   URLSearchParams 에 넣으면 %2F 가 다시 인코딩돼 인증이 깨진다.
JOB_CRAWLING_URL=
JOB_CRAWLING_API_KEY=
EXAM_CRAWLING_URL=
EXAM_CRAWLING_API_KEY=
# POST /lab/crawler/run 의 수집 실행 비밀번호
CRAWL_PASSWORD=

# Microsoft Azure AI Foundry — 신형 v1 경로만 지원 (api-version 쿼리 불필요)
#   AZURE_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
#   LLM_MODEL 에는 모델 id 가 아니라 "배포(deployment) 이름" 을 넣는다
AZURE_API_KEY=
AZURE_BASE_URL=

# Lablup Backend.AI
BACKENDAI_API_KEY=
BACKENDAI_BASE_URL=

OPENAI_API_KEY=

# ── 데모 사이트 이메일 인증 (SMTP) ───────────────────────────────────────
# src/app/demo/scholarship 의 회원가입 인증코드를 실제로 발송한다.
# Gmail: 구글 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호 발급(16자리).
#        평소 로그인 비밀번호가 아니라 그 앱 비밀번호를 넣는다.
# 비워두면 개발 환경에서만 코드가 응답에 실려 흐름이 이어진다(프로덕션은 503).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=미래희망장학재단

# 수신 제한. 비우면 누구에게나 발송된다(레이트 리밋은 항상 적용).
# 예) DEMO_MAIL_ALLOWLIST=me@gmail.com,@samin.dev
DEMO_MAIL_ALLOWLIST=

# ── Auth (better-auth · OAuth 전용) ──────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# 콜백 URL: {origin}/api/auth/callback/{google|github}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 릴레이 · 슬랙 (실험: /lab/relay) ─────────────────────────────────────
# 둘 다 없으면 /api/relay/slack/events 가 503 을 돌려주고 앱은 그대로 뜬다.
# api.slack.com/apps → From a manifest 에 아래 파일을 붙여 넣어 앱을 만든다:
#   src/app/(labs)/lab/relay/slack-manifest.json
# Basic Information → Signing Secret
SLACK_SIGNING_SECRET=
# OAuth & Permissions → Bot User OAuth Token (xoxb-…)
SLACK_BOT_TOKEN=

# ── 릴레이 · 텔레그램 (실험: /lab/relay) ──────────────────────────────────
# 둘 다 없으면 /api/relay/telegram 이 503 을 돌려주고 앱은 그대로 뜬다.
# 1) @BotFather 에게 /newbot → 토큰을 받는다
TELEGRAM_BOT_TOKEN=
# 2) 아무 랜덤 문자열. BotFather 가 주는 값이 아니라 직접 정한다.
#    openssl rand -hex 32
#
#    ⚠ 한 번 정하면 바꾸지 않는다. 빌드마다 새로 만들면 setWebhook 에 등록해 둔
#      값과 어긋나 모든 웹훅이 401 이 되고, 증상은 「봇이 아무 반응이 없다」로만
#      나타난다 — 로그도 조용하다.
TELEGRAM_WEBHOOK_SECRET=
#
# 3) 배포한 뒤 웹훅을 한 번 등록한다. 위 두 값을 그대로 쓴다:
#      curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#        -d url=https://antelope.up.railway.app/api/relay/telegram \
#        -d secret_token=<TELEGRAM_WEBHOOK_SECRET>
#    확인: curl "https://api.telegram.org/bot<토큰>/getWebhookInfo"
