# ── 데이터베이스 (Railway Postgres 플러그인이 자동 주입) ─────────────────
DATABASE_URL=

# ── LLM 프로바이더 스위치 ────────────────────────────────────────────────
# upstage | azure | backendai | openai | custom
LLM_PROVIDER=upstage
# 프리셋 기본값을 덮어쓸 때만 사용
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=

# Upstage — base https://api.upstage.ai/v1
#   chat:  solar-pro4(최신) / solar-pro3 / solar-pro2 / solar-mini
#   문서:  document-parse, ocr, information-extract (src/lib/upstage.ts)
UPSTAGE_API_KEY=

# Microsoft Azure AI Foundry
AZURE_API_KEY=
AZURE_BASE_URL=

# Lablup Backend.AI
BACKENDAI_API_KEY=
BACKENDAI_BASE_URL=

OPENAI_API_KEY=

# ── Auth (better-auth, 필요 시점에 활성화) ───────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
