# ── 데이터베이스 ────────────────────────────────────────────────────────
# 로컬: `pnpm docker:db` 로 띄운 뒤 아래 값 그대로 사용
# 프로덕션: Railway 가 ${{Postgres.DATABASE_URL}} 로 자동 주입
DATABASE_URL=postgres://postgres:postgres@localhost:5432/antelope

# ── LLM 프로바이더 스위치 ────────────────────────────────────────────────
# upstage | azure | backendai | openai | custom
LLM_PROVIDER=upstage
# 프리셋 기본값을 덮어쓸 때만 사용
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=

# Upstage — base https://api.upstage.ai/v1
#   chat:  solar-pro4(최신) / solar-pro3 / solar-pro2 / solar-mini
#   문서:  document-parse, ocr, information-extract (src/lib/upstage.ts)
UPSTAGE_API_KEY=

# Microsoft Azure AI Foundry — 신형 v1 경로만 지원 (api-version 쿼리 불필요)
#   AZURE_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
#   LLM_MODEL 에는 모델 id 가 아니라 "배포(deployment) 이름" 을 넣는다
AZURE_API_KEY=
AZURE_BASE_URL=

# Lablup Backend.AI
BACKENDAI_API_KEY=
BACKENDAI_BASE_URL=

OPENAI_API_KEY=

# ── Auth (better-auth · OAuth 전용) ──────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# 콜백 URL: {origin}/api/auth/callback/{google|github}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
